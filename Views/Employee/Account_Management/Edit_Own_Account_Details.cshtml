@model NZFTC_EMS.Models.PersonalAccountDetailsViewModel
@{
    Layout = null;
}

<div>
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">Edit my Account Details</h2>
    <form>
        <div style="display:flex; flex-direction:column; gap:10px; max-width:460px;">
            <label style="font-weight:700; color:#4A4A4A;">
                Address
                <input type="text" value="@Model.Address" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Email Address
                <input type="email" value="@Model.EmailAddress" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Phone Number
                <input type="text" value="@Model.PhoneNumber" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                New Password
                <input type="password" value="" autocomplete="new-password" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Confirm New Password
                <input type="password" value="" autocomplete="new-password" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <button type="button" disabled style="background:#C7CED6; color:#4A4A4A; border:none; border-radius:4px; padding:10px 14px; font-weight:700; width:max-content;">
                Save Changes (Next Integration)
            </button>
        </div>
    </form>
</div>
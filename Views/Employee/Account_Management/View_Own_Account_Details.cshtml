@model NZFTC_EMS.Models.PersonalAccountDetailsViewModel
@{
    Layout = null;
}

<div>
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">View my Account Details</h2>
    <dl style="margin:0; color:#4A4A4A; display:grid; grid-template-columns:220px 1fr; row-gap:8px;">
        <dt style="font-weight:700;">Account Type</dt>
        <dd style="margin:0;">@Model.AccountType</dd>

        <dt style="font-weight:700;">Business Role</dt>
        <dd style="margin:0;">@Model.BusinessRole</dd>

        <dt style="font-weight:700;">Job Role</dt>
        <dd style="margin:0;">@Model.JobRole</dd>

        <dt style="font-weight:700;">First Name</dt>
        <dd style="margin:0;">@Model.FirstName</dd>

        <dt style="font-weight:700;">Middle Name</dt>
        <dd style="margin:0;">@Model.MiddleName</dd>

        <dt style="font-weight:700;">Last Name</dt>
        <dd style="margin:0;">@Model.LastName</dd>

        <dt style="font-weight:700;">Date of Birth</dt>
        <dd style="margin:0;">@Model.DateOfBirth</dd>

        <dt style="font-weight:700;">Address</dt>
        <dd style="margin:0;">@Model.Address</dd>

        <dt style="font-weight:700;">Email Address</dt>
        <dd style="margin:0;">@Model.EmailAddress</dd>

        <dt style="font-weight:700;">Phone Number</dt>
        <dd style="margin:0;">@Model.PhoneNumber</dd>

        <dt style="font-weight:700;">Username</dt>
        <dd style="margin:0;">@Model.Username</dd>

        <dt style="font-weight:700;">IRD Number</dt>
        <dd style="margin:0;">@Model.IrdNumber</dd>

        <dt style="font-weight:700;">Account Status</dt>
        <dd style="margin:0;">@Model.AccountStatus</dd>

        <dt style="font-weight:700;">Failed Login Attempts</dt>
        <dd style="margin:0;">@Model.FailedLoginAttempts</dd>

        <dt style="font-weight:700;">Password Reset Required</dt>
        <dd style="margin:0;">@Model.PasswordResetRequired</dd>

        <dt style="font-weight:700;">Last Login Event</dt>
        <dd style="margin:0;">@Model.LastLoginEvent</dd>

        <dt style="font-weight:700;">Last Session Event</dt>
        <dd style="margin:0;">@Model.LastSessionEvent</dd>

        <dt style="font-weight:700;">Current Session Login Time</dt>
        <dd style="margin:0;">@Model.LoginTimeDisplay</dd>
    </dl>
</div>
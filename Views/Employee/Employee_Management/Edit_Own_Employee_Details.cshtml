@model NZFTC_EMS.Models.EmployeeRecordDetailsViewModel
@{
    Layout = null;
    var firstAidValue = (Model.FirstAidCertification ?? string.Empty).Trim();
    var firstAidYesSelected =
        firstAidValue.Equals("Certified", System.StringComparison.OrdinalIgnoreCase) ||
        firstAidValue.Equals("Yes", System.StringComparison.OrdinalIgnoreCase);
    var firstAidNoSelected =
        firstAidValue.Equals("Uncertified", System.StringComparison.OrdinalIgnoreCase) ||
        firstAidValue.Equals("No", System.StringComparison.OrdinalIgnoreCase);
    var emergencyContactRaw = (Model.EmergencyContact ?? string.Empty).Trim();
    var emergencyContactParts = emergencyContactRaw.Split('|', System.StringSplitOptions.TrimEntries | System.StringSplitOptions.RemoveEmptyEntries);
    if (emergencyContactParts.Length < 3)
    {
        emergencyContactParts = emergencyContactRaw.Split(',', System.StringSplitOptions.TrimEntries | System.StringSplitOptions.RemoveEmptyEntries);
    }
    var emergencyContactName = emergencyContactParts.Length > 0 ? emergencyContactParts[0] : string.Empty;
    var emergencyContactRelationship = emergencyContactParts.Length > 1 ? emergencyContactParts[1] : string.Empty;
    var emergencyContactPhoneNumber = emergencyContactParts.Length > 2 ? emergencyContactParts[2] : string.Empty;
}

<div>
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">Edit my Employee Information</h2>
    <p id="employee-details-help" style="margin:0 0 12px; color:#4A4A4A;">
        Keep these details current so emergency, health, and training records stay accurate. Complete every field; if something does not apply, enter "None".
    </p>
    <form method="post" action="@Url.Action("UpdateOwnEmployeeDetails", "Employee")" aria-describedby="employee-details-help">
        @Html.AntiForgeryToken()
        <div style="display:flex; flex-direction:column; gap:10px; max-width:460px;">
            <fieldset style="border:1px solid #C7CED6; border-radius:4px; padding:10px; background:#fff;">
                <legend style="font-weight:700; color:#4A4A4A; padding:0 6px;">Emergency Contact</legend>
                <div style="font-weight:700; color:#4A4A4A; display:flex; flex-direction:column; gap:6px; margin-bottom:8px;">
                    <label for="emergency-contact-name">Name</label>
                    <input id="emergency-contact-name" type="text" name="emergencyContactName" required value="@emergencyContactName" autocomplete="name" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
                </div>
                <div style="font-weight:700; color:#4A4A4A; display:flex; flex-direction:column; gap:6px; margin-bottom:8px;">
                    <label for="emergency-contact-relationship">Relationship</label>
                    <input id="emergency-contact-relationship" type="text" name="emergencyContactRelationship" required value="@emergencyContactRelationship" autocomplete="off" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
                </div>
                <div style="font-weight:700; color:#4A4A4A; display:flex; flex-direction:column; gap:6px;">
                    <label for="emergency-contact-phone-number">Phone Number</label>
                    <input id="emergency-contact-phone-number" type="tel" name="emergencyContactPhoneNumber" required value="@emergencyContactPhoneNumber" autocomplete="tel" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
                </div>
            </fieldset>
            <div style="display:flex; flex-direction:column; gap:6px;">
                <label for="diagnosed-health-conditions" style="font-weight:700; color:#4A4A4A;">Diagnosed Health Conditions</label>
                <input id="diagnosed-health-conditions" type="text" name="diagnosedHealthConditions" required value="@Model.DiagnosedHealthConditions" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </div>
            <div style="display:flex; flex-direction:column; gap:6px;">
                <label for="allergies" style="font-weight:700; color:#4A4A4A;">Allergies</label>
                <input id="allergies" type="text" name="allergies" required value="@Model.Allergies" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </div>
            <div style="display:flex; flex-direction:column; gap:6px;">
                <label for="approved-emergency-steps-and-medicines" style="font-weight:700; color:#4A4A4A;">Approved Emergency Steps and Medicines</label>
                <input id="approved-emergency-steps-and-medicines" type="text" name="approvedEmergencyStepsAndMedicines" required value="@Model.ApprovedEmergencyStepsAndMedicines" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </div>
            <div style="display:flex; flex-direction:column; gap:6px;">
                <label for="prior-training-and-qualifications" style="font-weight:700; color:#4A4A4A;">Prior Training and Qualifications</label>
                <input id="prior-training-and-qualifications" type="text" name="priorTrainingAndQualifications" required value="@Model.PriorTrainingAndQualifications" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </div>
            <fieldset style="border:1px solid #C7CED6; border-radius:4px; padding:10px; background:#fff;">
                <legend style="font-weight:700; color:#4A4A4A; padding:0 6px;">First Aid Certification</legend>
                <p id="first-aid-help" style="margin:0 0 8px; color:#4A4A4A; font-weight:400;">
                    Select the certification status currently held on your employee record.
                </p>
                <label style="display:flex; align-items:center; gap:8px; color:#4A4A4A; font-weight:700; margin-bottom:6px;">
                    <input type="radio" name="firstAidCertification" value="Yes" aria-describedby="first-aid-help" @(firstAidYesSelected ? "checked" : null) />
                    Yes
                </label>
                <label style="display:flex; align-items:center; gap:8px; color:#4A4A4A; font-weight:700;">
                    <input type="radio" name="firstAidCertification" value="No" aria-describedby="first-aid-help" @(firstAidNoSelected ? "checked" : null) />
                    No
                </label>
            </fieldset>
            <button type="submit" style="background:#5BA6A6; color:#4A4A4A; border:1px solid rgba(42, 93, 143, 0.2); border-radius:4px; padding:10px 14px; font-weight:700; width:max-content;">
                Save Changes
            </button>
        </div>
    </form>
</div>
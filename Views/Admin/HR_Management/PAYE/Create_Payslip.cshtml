@using System.Text.Json
@model NZFTC_EMS.Models.SelectedEmployeeActionTargetViewModel

@{
    Layout = null;
    var submitAction = Url.Action("CreatePayslipForEmployee", "Admin");
    var hasTargetEmployee = !string.IsNullOrWhiteSpace(Model.SelectedUsername);
    var employeeName = string.IsNullOrWhiteSpace(Model.SelectedEmployeeName) ? Model.SelectedUsername : Model.SelectedEmployeeName;
    var payslip = Model.PayslipDraft ?? new NZFTC_EMS.Models.PayslipRecord();
    var packageName = string.IsNullOrWhiteSpace(payslip.SalaryPackageDisplayName) ? payslip.SalaryPackageName : payslip.SalaryPackageDisplayName;
}

<style>
    .selected-target-controls {
        display: flex;
        flex-wrap: nowrap;
        gap: 10px;
        align-items: flex-end;
        margin-bottom: 16px;
        overflow-x: auto;
    }

    .selected-target-controls label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-weight: 700;
        color: #4A4A4A;
    }

    .selected-target-controls select {
        width: 240px;
        min-width: 240px;
        max-width: 240px;
        padding: 8px;
        border: 1px solid #C7CED6;
        border-radius: 4px;
        background: #FFFFFF;
        color: #4A4A4A;
    }

    .selected-target-load-button,
    .primary-button {
        background: #2A5D8F;
        color: #FFFFFF;
        border: none;
        border-radius: 6px;
        padding: 10px 16px;
        font-weight: 700;
        cursor: pointer;
    }

    .selected-target-load-button:hover,
    .primary-button:hover {
        background: #5BA6A6;
    }

    .payslip-panel { color: #2A5D8F; }
    .payslip-panel h2 { margin-bottom: 10px; }
    .payslip-intro { color: #4A4A4A; margin-bottom: 16px; }
    .payslip-help-text { color: #4A4A4A; margin: 0; font-size: 13px; line-height: 1.5; }
    .payslip-form { max-width: 720px; display: flex; flex-direction: column; gap: 16px; }
    .form-row { display: flex; flex-direction: column; gap: 8px; }
    .two-column { display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 16px; }
    .form-row label, .employee-readonly-label { font-weight: 700; color: #2A5D8F; }
    .payslip-form input { width: 100%; border: 1px solid #C7CED6; border-radius: 6px; padding: 10px 12px; font-size: 14px; }
</style>

<div class="payslip-panel"
     data-selected-target-root
     data-endpoint="@Model.ContentEndpoint"
     data-action-key="create-payslip-for-employee"
     data-usernames-by-group="@JsonSerializer.Serialize(Model.UsernamesByGroup)"
     data-display-names="@JsonSerializer.Serialize(Model.UsernameDisplayNames)">
    <h2>Create Payslip for Employee</h2>
    <p class="payslip-intro">
        @(hasTargetEmployee
            ? $"Enter the current pay components for {employeeName}."
            : "Select a department and employee, then click Load.")
    </p>
    <p id="payslip-target-help" class="payslip-help-text">Select the employee first, then enter the pay values to generate a payslip.</p>

    <div class="selected-target-controls" aria-describedby="payslip-target-help">
        <label for="payslip-selected-group">
            Business Department
            <select id="payslip-selected-group" data-selected-group>
                <option value="">Select a department...</option>
                <option value="admin" selected="@(Model.SelectedGroup == "admin" ? "selected" : null)">Admin</option>
                <option value="finance" selected="@(Model.SelectedGroup == "finance" ? "selected" : null)">Finance</option>
                <option value="trade" selected="@(Model.SelectedGroup == "trade" ? "selected" : null)">Trade</option>
            </select>
        </label>

        <label for="payslip-selected-username">
            Employee
            <select id="payslip-selected-username" data-selected-username>
                <option value="">Select an employee...</option>
                @foreach (var username in Model.Usernames)
                {
                    var displayName = Model.UsernameDisplayNames.TryGetValue(username, out var resolvedDisplayName) ? resolvedDisplayName : username;
                    <option value="@username" selected="@(Model.SelectedUsername == username ? "selected" : null)">@displayName</option>
                }
            </select>
        </label>

        <button type="button" class="selected-target-load-button" data-load-selected-target aria-describedby="payslip-target-help">Load</button>
    </div>

    @if (hasTargetEmployee)
    {
        <form method="post" action="@submitAction" class="payslip-form" aria-describedby="create-payslip-help create-payslip-deduction-help">
            @Html.AntiForgeryToken()
            <input type="hidden" name="submittedForUsername" value="@payslip.Username" />

            <div class="form-row">
                <label class="employee-readonly-label" for="PayslipEmployeeName">Employee</label>
                <input class="form-control" id="PayslipEmployeeName" value="@employeeName" readonly aria-readonly="true" />
            </div>

            <p id="create-payslip-help" class="payslip-help-text">Gross pay and deductions are used to generate the payslip output.</p>

            <div class="form-row">
                <label for="basePay">Base Pay</label>
                <input type="number" step="0.01" min="0" id="basePay" name="basePay" value="@payslip.BasePay" required />
            </div>

            <div class="form-row two-column">
                <div>
                    <label for="overtimePay">Overtime Pay</label>
                    <input type="number" step="0.01" min="0" id="overtimePay" name="overtimePay" value="@payslip.OvertimePay" />
                </div>
                <div>
                    <label for="bonusPay">Bonus Pay</label>
                    <input type="number" step="0.01" min="0" id="bonusPay" name="bonusPay" value="@payslip.BonusPay" />
                </div>
            </div>

            <div class="form-row two-column">
                <div>
                    <label for="allowancePay">Allowances</label>
                    <input type="number" step="0.01" min="0" id="allowancePay" name="allowancePay" value="@payslip.AllowancePay" />
                </div>
                <div>
                    <label for="preTaxDeductions">Pre-tax Deductions</label>
                    <input type="number" step="0.01" min="0" id="preTaxDeductions" name="preTaxDeductions" value="@payslip.PreTaxDeductions" />
                </div>
            </div>

            <div class="form-row">
                <label for="postTaxDeductions">Post-tax Deductions</label>
                <input type="number" step="0.01" min="0" id="postTaxDeductions" name="postTaxDeductions" value="@payslip.PostTaxDeductions" />
            </div>

            <p class="payslip-help-text" id="create-payslip-deduction-help">Pre-tax deductions reduce the taxable amount; post-tax deductions reduce the final take-home pay.</p>

            <div class="form-row">
                <label for="payPeriod">Pay Period</label>
                <input type="text" id="payPeriod" name="payPeriod" aria-describedby="pay-period-help" value="@payslip.PayPeriod" />
                <div id="pay-period-help" class="payslip-help-text">Use the label you want printed on the payslip, for example Fortnight ending 30 Aug 2026.</div>
            </div>

            <div class="form-row">
                <label for="payFrequency">Pay Frequency</label>
                <input type="text" id="payFrequency" name="payFrequency" aria-describedby="pay-frequency-help" value="@payslip.PayFrequency" />
                <div id="pay-frequency-help" class="payslip-help-text">Enter the payroll cadence such as Weekly, Fortnightly, or Monthly.</div>
            </div>

            <button type="submit" class="primary-button">Create Payslip</button>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(packageName))
    {
        <hr />
        <div class="card mt-3" role="region" aria-label="Leave snapshot">
            <div class="card-body">
                <h4 class="card-title">Leave Snapshot</h4>
                <p><strong>Package:</strong> @packageName</p>
                <p><strong>Annual Leave:</strong> @payslip.AnnualLeaveLawfulDays lawful + @payslip.AnnualLeavePackageExtraDays extra = @payslip.AnnualLeaveRemainingDays remaining</p>
                <p><strong>Sick Leave:</strong> @payslip.SickLeaveLawfulDays lawful + @payslip.SickLeavePackageExtraDays extra = @payslip.SickLeaveRemainingDays remaining</p>
                <p><strong>Special Leave:</strong> @payslip.SpecialLeaveLawfulDays lawful + @payslip.SpecialLeavePackageExtraDays extra = @payslip.SpecialLeaveRemainingDays remaining</p>
                <p><strong>Parental Leave:</strong> @payslip.ParentalLeaveLawfulWeeks lawful + @payslip.ParentalLeavePackageExtraWeeks extra = @payslip.ParentalLeaveRemainingWeeks remaining</p>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        const root = document.querySelector("[data-selected-target-root]");
        if (!root || root.dataset.bound === "true") {
            return;
        }

        root.dataset.bound = "true";
        const endpoint = root.dataset.endpoint || "";
        const actionKey = root.dataset.actionKey || "";
        const usernamesByGroup = JSON.parse(root.dataset.usernamesByGroup || "{}");
        const displayNames = JSON.parse(root.dataset.displayNames || "{}");
        const groupSelect = root.querySelector("[data-selected-group]");
        const usernameSelect = root.querySelector("[data-selected-username]");
        const loadButton = root.querySelector("[data-load-selected-target]");
        const host = root.closest("[data-account-content-host]");

        if (!endpoint || !actionKey || !groupSelect || !usernameSelect || !loadButton || !host) {
            return;
        }

        function normalizeGroup(group) {
            return (group || "").trim().toLowerCase();
        }

        function setUsernameOptions(group, selectedUsername) {
            const usernames = Array.isArray(usernamesByGroup[normalizeGroup(group)]) ? usernamesByGroup[normalizeGroup(group)] : [];
            const safeSelectedUsername = (selectedUsername || "").trim();
            usernameSelect.innerHTML = '<option value="">Select an employee...</option>' + usernames.map((username) => {
                const selected = username === safeSelectedUsername ? " selected" : "";
                const displayName = displayNames[username] || username;
                return `<option value="${username.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")}"${selected}>${displayName.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")}</option>`;
            }).join("");

            if (safeSelectedUsername && usernames.includes(safeSelectedUsername)) {
                usernameSelect.value = safeSelectedUsername;
            } else if (usernames.length > 0) {
                usernameSelect.value = "";
            }
        }

        async function loadTarget(group, username) {
            loadButton.disabled = true;
            try {
                if (!username) {
                    return;
                }

                const response = await fetch(`${endpoint}?actionKey=${encodeURIComponent(actionKey)}&group=${encodeURIComponent(group)}&username=${encodeURIComponent(username)}`, { credentials: "same-origin" });
                if (!response.ok) {
                    host.textContent = "Unable to load the selected employee right now.";
                    return;
                }

                const html = await response.text();
                if (typeof window.nzftcSetAccountContentHostHtml === "function") {
                    window.nzftcSetAccountContentHostHtml(host, html);
                } else {
                    host.innerHTML = html;
                }
            } catch (error) {
                console.error(error);
                host.textContent = "Unable to load the selected employee right now.";
            } finally {
                loadButton.disabled = false;
            }
        }

        groupSelect.addEventListener("change", () => {
            setUsernameOptions(groupSelect.value, "");
        });

        loadButton.addEventListener("click", () => {
            loadTarget(groupSelect.value, usernameSelect.value);
        });
    })();
</script>

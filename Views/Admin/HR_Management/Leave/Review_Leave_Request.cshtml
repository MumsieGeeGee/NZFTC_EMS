@model NZFTC_EMS.Models.LeaveRequest
@{
    Layout = null;
    var leaveRequest = Model ?? new NZFTC_EMS.Models.LeaveRequest();
    var selectedStatus = string.IsNullOrWhiteSpace(leaveRequest.Status) ? "Open" : leaveRequest.Status;
    var displayStatus = string.Equals(leaveRequest.Status, "Denied", System.StringComparison.OrdinalIgnoreCase)
        ? "Fully Denied"
        : leaveRequest.Status;
}

<style>
    .review-panel {
        background: #FFFFFF;
        border: 1px solid #C7CED6;
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 2px 6px rgba(42, 93, 143, 0.08);
        color: #2A5D8F;
    }
    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }
    .status-badge {
        background: #5BA6A6;
        color: #FFFFFF;
        padding: 6px 10px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }
    .review-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .detail-block, .description-box {
        background: #F5F7FA;
        border: 1px solid #C7CED6;
        border-radius: 8px;
        padding: 14px;
        color: #4A4A4A;
    }
    .detail-block strong {
        display: block;
        margin-bottom: 8px;
        color: #2A5D8F;
    }
    .description-box {
        line-height: 1.6;
    }
    .review-help-text {
        color: #4A4A4A;
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
    }
    .form-section {
        border-top: 1px solid #C7CED6;
        padding-top: 20px;
        margin-top: 24px;
    }
    .form-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 18px;
    }
    label {
        font-weight: 700;
        color: #2A5D8F;
    }
    select, textarea {
        width: 100%;
        border: 1px solid #C7CED6;
        border-radius: 6px;
        padding: 10px 12px;
        font-size: 14px;
        font-family: inherit;
        background: #FFFFFF;
        color: #4A4A4A;
    }
    textarea {
        min-height: 120px;
        resize: vertical;
    }
    .form-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-top: 8px;
    }
    .primary-btn, .secondary-link {
        display: inline-block;
        border-radius: 6px;
        padding: 10px 16px;
        font-weight: 700;
        text-decoration: none;
        border: none;
        cursor: pointer;
    }
    .primary-btn {
        background: #2A5D8F;
        color: #FFFFFF;
    }
    .primary-btn:hover {
        background: #5BA6A6;
    }
    .secondary-link {
        background: #C7CED6;
        color: #4A4A4A;
    }
    .secondary-link:hover {
        background: #5BA6A6;
        color: #FFFFFF;
    }
</style>

<div class="review-panel">
    <div class="review-header">
        <div>
            <h2>Review Leave Request</h2>
            <p>Record the decision for this leave application and communicate the outcome clearly.</p>
        </div>
        <span class="status-badge" role="status" aria-label="Current leave request status">@displayStatus</span>
    </div>

    <div class="review-grid">
        <div class="detail-block">
            <strong>Employee</strong>
            <span>@leaveRequest.EmployeeName</span>
        </div>
        <div class="detail-block">
            <strong>Submitted by</strong>
            <span>@leaveRequest.SubmittedByUsername</span>
        </div>
        <div class="detail-block">
            <strong>Leave type</strong>
            <span>@leaveRequest.LeaveType</span>
        </div>
        <div class="detail-block">
            <strong>Requested days</strong>
            <span>@leaveRequest.TotalDays</span>
        </div>
    </div>

    <div class="detail-block">
        <strong>Leave dates</strong>
        <div>@leaveRequest.StartDate.ToString("dd MMM yyyy") to @leaveRequest.EndDate.ToString("dd MMM yyyy")</div>
    </div>

    <div class="description-box" style="margin-top: 16px;" role="region" aria-label="Leave request reason">
        @leaveRequest.Reason
    </div>

    <form method="post" action="@Url.Action("UpdateLeaveRequestStatus", "Admin")" class="form-section" aria-describedby="leave-review-help">
        @Html.AntiForgeryToken()
        <input type="hidden" name="leaveRequestId" value="@leaveRequest.Id" />
        <p id="leave-review-help" class="review-help-text">Choose the decision outcome and provide a clear explanation so the employee can understand the result.</p>

        <div class="form-row">
            <label for="status">Decision</label>
            <select id="status" name="status" aria-describedby="leave-review-help">
                <option value="Approved" selected="@(selectedStatus == "Approved" ? "selected" : null)">Approve</option>
                <option value="Temporarily Denied" selected="@(selectedStatus == "Temporarily Denied" ? "selected" : null)">Temporarily Denied</option>
                <option value="Fully Denied" selected="@(selectedStatus == "Denied" ? "selected" : null)">Fully Deny</option>
            </select>
        </div>

        <div class="form-row">
            <label for="decisionReason">Decision reason</label>
            <textarea id="decisionReason" name="decisionReason" aria-describedby="leave-review-reason-help">@leaveRequest.DecisionReason</textarea>
            <p id="leave-review-reason-help" class="review-help-text">Summarise the approval, temporary denial, or denial reason in plain language.</p>
        </div>

        <div class="form-actions">
            <button type="submit" class="primary-btn">Save decision</button>
            <a href="@Url.Action("HRManagement", "Admin", new { actionKey = "view-selected-employee-open-leave-requests" })" class="secondary-link">Back to HR management</a>
        </div>
    </form>
</div>

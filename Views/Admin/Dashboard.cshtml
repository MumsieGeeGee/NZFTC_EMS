@model dynamic
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>NZFTC EMS - Admin Dashboard</title>
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-regular-rounded/css/uicons-regular-rounded.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lucida Sans', 'Lucida Grande', sans-serif;
            background: #F5F7FA;
        }

        .dashboard-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        /* HEADER BAR - 180px total */
        .header-bar {
            height: 180px;
            display: flex;
            flex-direction: column;
        }

        /* Top row: NZFTC logo (left, dark blue) + Session Time label (right, teal) */
        .header-top-row {
            display: flex;
            flex: 1;
        }

        .header-left {
            flex: 1;
            background: #2A5D8F;
            padding: 14px 24px;
            display: flex;
            align-items: center;
        }

        .header-title {
            font-size: 64px;
            font-weight: bold;
            color: #F5F7FA;
            margin: 0;
        }

        .header-right {
            flex: 1;
            background: #5BA6A6;
            padding: 14px 24px;
            display: flex;
            align-items: center;
        }

        .session-label {
            font-size: 18px;
            font-weight: 700;
            color: #4A4A4A;
        }

        /* Bottom row: Date/Time (left, teal) + Timeout + Logout (right, dark blue) */
        .header-bottom-row {
            display: flex;
            flex: 1;
        }

        .header-date-left {
            flex: 1;
            background: #5BA6A6;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .current-datetime {
            font-size: 18px;
            font-weight: 700;
            color: #4A4A4A;
        }

        .dashboard-label {
            background: #C7CED6;
            color: #4A4A4A;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-left: auto;
            text-decoration: none;
        }

        .header-action-right {
            flex: 1;
            background: #2A5D8F;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .timeout-block {
            display: flex;
            align-items: center;
        }

        .timeout-label {
            font-size: 18px;
            font-weight: 700;
            color: #F5F7FA;
        }

        .logout-btn {
            background: #1A73E8;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .logout-btn:hover {
            background: #B33A3A;
        }

        /* MAIN CONTENT AREA */
        .main-content-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
            --sidebar-width: 130px;
        }

        /* LEFT SIDEBAR */
        .left-sidebar {
            width: var(--sidebar-width);
            background: #2A5D8F;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: center;
            overflow-y: auto;
            border-right: 1px solid rgba(0, 0, 0, 0.1);
        }

        .sidebar-button {
            width: 110px;
            height: 200px;
            background: #5BA6A6;
            border: 1px solid rgba(245, 247, 250, 0.55);
            border-radius: 8px;
            color: #4A4A4A;
            padding: 10px 10px 10px;
            text-align: center;
            font-size: 14px;
            line-height: 1.2;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            gap: 16px;
            text-decoration: none;
        }

        .sidebar-button .fi {
            font-size: 72px;
            line-height: 1;
        }

        .sidebar-button:hover {
            background: #C7CED6;
        }

        .sidebar-button:active {
            background: rgba(255, 255, 255, 0.26);
        }

        .sidebar-button.active {
            background: #F5F7FA;
            color: #2A5D8F;
        }

        /* MAIN CONTENT AREA */
        .main-content {
            flex: 1;
            background: #F5F7FA;
            overflow: hidden;
            padding: 0;
            display: grid;
            grid-template-columns: calc((100% - var(--sidebar-width)) / 2) calc((100% + var(--sidebar-width)) / 2);
            align-items: flex-start;
            gap: 0;
        }

        .main-content-text {
            min-width: 0;
            padding: 24px;
        }

        .notification-panel {
            background: #F5F7FA;
            border: 1px solid #C7CED6;
            border-radius: 8px;
            padding: 16px;
            margin-top: 16px;
        }

        .notification-panel h2 {
            color: #2A5D8F;
            margin-bottom: 12px;
        }

        .notification-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .notification-item {
            background: #FFFFFF;
            border: 1px solid #C7CED6;
            border-left: 4px solid #2A5D8F;
            border-radius: 8px;
            padding: 12px 14px;
            box-shadow: 0 1px 2px rgba(42, 93, 143, 0.06);
        }

        .notification-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            gap: 12px;
        }

        .notification-badge {
            color: #FFFFFF;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .notification-grievance { background: #2A5D8F; }
        .notification-leave { background: #5BA6A6; }
        .notification-account { background: #1A73E8; }

        .notification-time {
            color: #4A4A4A;
            font-size: 12px;
            font-weight: 700;
        }

        .notification-item strong {
            display: block;
            color: #2A5D8F;
            margin-bottom: 6px;
        }

        .notification-item p {
            color: #4A4A4A;
            margin-bottom: 0;
            line-height: 1.5;
        }

        .main-content-calendar {
            width: 100%;
            display: flex;
            justify-content: flex-start;
            padding: 0;
        }

        .main-content-calendar .dashboard-calendar-widget {
            width: 100%;
            max-width: none;
        }

        .main-content h1 {
            color: #2A5D8F;
            font-size: 28px;
            margin-bottom: 8px;
        }

        .main-content p {
            color: #5BA6A6;
            font-size: 14px;
            margin-bottom: 24px;
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- HEADER BAR -->
        <div class="header-bar">
            <!-- Top: Logo + Session Label -->
            <div class="header-top-row">
                <div class="header-left">
                    <div class="header-title">NZFTC</div>
                </div>
                <div class="header-right">
                    <span class="session-label">Current Session Time:</span>
                </div>
            </div>

            <!-- Bottom: Date/Time + Timeout/Logout -->
            <div class="header-bottom-row">
                <div class="header-date-left">
                    <span class="current-datetime" id="dateTime"></span>
                    <span class="dashboard-label">Admin Dashboard</span>
                </div>
                <div class="header-action-right">
                    <div class="timeout-block">
                        <span class="timeout-label">Session Timeout:</span>
                    </div>
                    <form method="post" action="@Url.Action("Logout", "Login")" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- MAIN CONTENT AREA -->
        <div class="main-content-wrapper">
            <!-- LEFT SIDEBAR -->
            <div class="left-sidebar">
                @if ((bool?)ViewBag.CanAccessAccountModule == true)
                {
                    <a href="@Url.Action("AccountManagement", "Admin")" class="sidebar-button">
                        <i class="fi fi-rr-user" aria-hidden="true"></i>
                        <span>Account Management</span>
                    </a>
                }
                @if ((bool?)ViewBag.CanAccessEmployeeModule == true)
                {
                    <a href="@Url.Action("EmployeeManagement", "Admin")" class="sidebar-button">
                        <i class="fi fi-rr-briefcase" aria-hidden="true"></i>
                        <span>Employee Management</span>
                    </a>
                }
                @if ((bool?)ViewBag.CanAccessHrModule == true)
                {
                    <a href="@Url.Action("HRManagement", "Admin")" class="sidebar-button">
                        <i class="fi fi-rr-calendar" aria-hidden="true"></i>
                        <span>HR Management</span>
                    </a>
                }
            </div>
            <div class="main-content">
                <div class="main-content-text">
                    <h1>Admin Dashboard</h1>
                    @{
                        var dashboardNotifications = ViewBag.DashboardNotifications as IEnumerable<NZFTC_EMS.Models.DashboardNotification> ?? System.Linq.Enumerable.Empty<NZFTC_EMS.Models.DashboardNotification>();
                    }
                    @await Html.PartialAsync("~/Views/Shared/Notification_Panel.cshtml", dashboardNotifications)
                </div>
                <div class="main-content-calendar">
                    @await Html.PartialAsync("~/Views/Shared/Calendar_Widget.cshtml")
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const sessionLabel = document.querySelector('.session-label');
            const timeoutLabel = document.querySelector('.timeout-label');
            const timeoutValueElement = document.createElement('span');
            const logoutForm = document.querySelector('form[action*="Logout"]');
            const dateTimeElement = document.getElementById('dateTime');
            const loginTimeIso = '@(ViewBag.LoginTime ?? string.Empty)';
            const normalizedLoginTimeIso = loginTimeIso.replace(/&#x2B;/g, '+');
            const parsedLoginStart = normalizedLoginTimeIso ? new Date(normalizedLoginTimeIso) : null;
            const loginStartMs = parsedLoginStart && !Number.isNaN(parsedLoginStart.getTime())
                ? parsedLoginStart.getTime()
                : Date.now();
            const sessionTimeoutSeconds = 15 * 60;
            const dangerThresholdSeconds = 60;
            const touchThrottleMs = 30 * 1000;
            let lastActivityMs = Date.now();
            let lastTouchMs = 0;
            let logoutTriggered = false;

            timeoutLabel.textContent = 'Session Timeout:';
            timeoutValueElement.className = 'timeout-value';
            timeoutValueElement.style.marginLeft = '6px';
            timeoutLabel.appendChild(timeoutValueElement);

            function updateDateTime() {
                const now = new Date();
                const day = String(now.getDate()).padStart(2, '0');
                const month = now.toLocaleString('en-US', { month: 'short' });
                const year = now.getFullYear();
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                dateTimeElement.textContent = `${day} ${month} ${year} ${hours}:${minutes}`;
            }

            function formatElapsed(totalSeconds) {
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;
                return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }

            function updateSessionElapsed() {
                const elapsedSeconds = Math.max(0, Math.floor((Date.now() - loginStartMs) / 1000));
                sessionLabel.textContent = `Current Session Time: ${formatElapsed(elapsedSeconds)}`;
            }

            function formatCountdown(totalSeconds) {
                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;
                return `${minutes}:${String(seconds).padStart(2, '0')}`;
            }

            function updateTimeoutDisplay(remainingSeconds) {
                timeoutValueElement.textContent = formatCountdown(remainingSeconds);
                if (remainingSeconds <= dangerThresholdSeconds) {
                    timeoutValueElement.style.color = '#B33A3A';
                    return;
                }

                timeoutValueElement.style.color = remainingSeconds < sessionTimeoutSeconds ? '#E6A700' : '#F5F7FA';
            }

            function submitLogout() {
                if (logoutTriggered) {
                    return;
                }

                logoutTriggered = true;
                fetch('@Url.Action("TimeoutLogout", "Session")', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .finally(() => {
                        window.location.href = '@Url.Action("Login", "Login")';
                    });
            }

            function touchServerSession() {
                const now = Date.now();
                if (now - lastTouchMs < touchThrottleMs) {
                    return;
                }

                lastTouchMs = now;
                fetch('@Url.Action("Touch", "Session")', {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then((response) => {
                        if (response.status === 401) {
                            submitLogout();
                            return;
                        }

                        if (!response.ok) {
                            console.error(`Session touch failed with status ${response.status}.`);
                        }
                    })
                    .catch((error) => {
                        console.error('Session touch request failed.', error);
                    });
            }

            function registerActivity() {
                lastActivityMs = Date.now();
                updateTimeoutDisplay(sessionTimeoutSeconds);
                touchServerSession();
            }

            ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart'].forEach((eventName) => {
                window.addEventListener(eventName, registerActivity, { passive: true });
            });

            updateDateTime();
            updateSessionElapsed();
            updateTimeoutDisplay(sessionTimeoutSeconds);

            setInterval(() => {
                updateDateTime();
                updateSessionElapsed();

                const idleSeconds = Math.floor((Date.now() - lastActivityMs) / 1000);
                const remainingSeconds = sessionTimeoutSeconds - idleSeconds;
                if (remainingSeconds <= 0) {
                    submitLogout();
                    return;
                }

                updateTimeoutDisplay(remainingSeconds);
            }, 1000);
        })();
    </script>
    <script src="~/js/sidebar-prefetch.js" asp-append-version="true"></script>
</body>
</html>

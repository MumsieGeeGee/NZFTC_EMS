@using NZFTC_EMS.Data
@using NZFTC_EMS.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/Defaults/Portal_Shell_Layout.cshtml";
    ViewBag.PortalShellController = "Admin";
    ViewBag.PortalShellActiveModule = "dashboard";
    ViewBag.PortalShellHeading = "Admin Dashboard";
    ViewBag.PortalShellReturnLabel = "Admin Dashboard";
    ViewBag.PortalShellMainContentClass = "main-content main-content-dashboard";
    var dashboardNotifications = ViewBag.DashboardNotifications as IEnumerable<DashboardNotification> ?? Enumerable.Empty<DashboardNotification>();
    var mySqlStatus = ViewBag.MySqlStatus as MySqlStatusSnapshot;
    var mySqlStatusError = ViewBag.MySqlStatusError as string;
    var mySqlOnline = mySqlStatus?.CanConnect == true;
    var employeeDataAvailable = mySqlStatus != null && mySqlStatus.EmployeeCount > 0 && mySqlStatus.AccountDetailsCount > 0;
    var taxDataAvailable = mySqlStatus != null && mySqlStatus.TaxInformationCount > 0;
    var payeOnline = mySqlOnline && taxDataAvailable;
    var payslipGenerationReady = mySqlStatus != null && mySqlOnline && mySqlStatus.EmployeeCount > 0 && mySqlStatus.TaxInformationCount > 0;
    var sessionAuditActive = mySqlStatus != null && mySqlOnline && (mySqlStatus.ActiveSessionCount > 0 || mySqlStatus.AuditEventCount > 0);
}

<div class="main-content-text">
    <h1>Admin Dashboard</h1>
    @await Html.PartialAsync("~/Views/Shared/Notification_Panel.cshtml", dashboardNotifications)

    <section class="mysql-status-panel" aria-labelledby="mysql-status-heading">
        <div class="mysql-status-header">
            <h2 id="mysql-status-heading">System Data Status</h2>
            @if (mySqlStatus != null)
            {
                <span class="mysql-status-badge @(mySqlStatus.CanConnect ? "ok" : "error")">
                    @(mySqlStatus.CanConnect ? "Online" : "Unavailable")
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(mySqlStatusError))
            {
                <span class="mysql-status-badge error">Unavailable</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(mySqlStatusError))
        {
            <p class="mysql-status-error">Unable to read MySQL status: @mySqlStatusError</p>
        }
        else if (mySqlStatus != null)
        {
            <div class="mysql-status-grid">
                <div class="mysql-status-card">
                    <strong>MySQL</strong>
                    <span class="mysql-status-state @(mySqlOnline ? "ok" : "error")">@(mySqlOnline ? "Online" : "Offline")</span>
                    <small>Web runtime database connectivity.</small>
                </div>
                <div class="mysql-status-card">
                    <strong>Employee Data</strong>
                    <span class="mysql-status-state @(employeeDataAvailable ? "ok" : "warning")">@(employeeDataAvailable ? "Available" : "Needs Review")</span>
                    <small>Employee and account details are synced.</small>
                </div>
                <div class="mysql-status-card">
                    <strong>PAYE Online</strong>
                    <span class="mysql-status-state @(payeOnline ? "ok" : "warning")">@(payeOnline ? "Ready" : "Pending")</span>
                    <small>Tax records are available for payroll use.</small>
                </div>
                <div class="mysql-status-card">
                    <strong>Payslip Generation</strong>
                    <span class="mysql-status-state @(payslipGenerationReady ? "ok" : "warning")">@(payslipGenerationReady ? "Ready" : "Pending")</span>
                    <small>Payslips can be generated from current data.</small>
                </div>
                <div class="mysql-status-card">
                    <strong>Session Audit</strong>
                    <span class="mysql-status-state @(sessionAuditActive ? "ok" : "warning")">@(sessionAuditActive ? "Active" : "Waiting")</span>
                    <small>Login/session audit persistence is enabled.</small>
                </div>
                <div class="mysql-status-card">
                    <strong>Total Locked Accounts</strong>
                    <span>@mySqlStatus.LockedAccountCount</span>
                    <small>Live total from current stored account states.</small>
                </div>
            </div>
        }
    </section>
</div>
<div class="main-content-calendar">
    @await Html.PartialAsync("~/Views/Shared/Calendar_Widget.cshtml")
</div>

@model NZFTC_EMS.Models.SelectedEmployeeAccountDetailsViewModel
@{
    Layout = null;
}

<div data-selected-account-root data-endpoint="@Model.ContentEndpoint" data-action-key="delete-employee-account">
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">Delete an Employee Account</h2>

    <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:end; margin-bottom:12px;">
        <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#4A4A4A;">
            Business Department
            <select data-selected-group style="min-width:220px; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#FFFFFF; color:#4A4A4A;">
                <option value="">Select a department...</option>
                @if (Model.SelectedGroup == "admin")
                {
                    <option value="admin" selected>Admin</option>
                }
                else
                {
                    <option value="admin">Admin</option>
                }
                @if (Model.SelectedGroup == "finance")
                {
                    <option value="finance" selected>Finance</option>
                }
                else
                {
                    <option value="finance">Finance</option>
                }
                @if (Model.SelectedGroup == "trade")
                {
                    <option value="trade" selected>Trade</option>
                }
                else
                {
                    <option value="trade">Trade</option>
                }
            </select>
        </label>

        <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#4A4A4A;">
            Employee
            <select data-selected-username style="min-width:220px; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#FFFFFF; color:#4A4A4A;">
                <option value="">Select an employee...</option>
                @foreach (var username in Model.Usernames)
                {
                    var displayName = Model.UsernameDisplayNames.TryGetValue(username, out var resolvedDisplayName) ? resolvedDisplayName : username;
                    if (Model.SelectedUsername == username)
                    {
                        <option value="@username" selected>@displayName</option>
                    }
                    else
                    {
                        <option value="@username">@displayName</option>
                    }
                }
            </select>
        </label>

        <button type="button" data-load-selected-account style="background:#5BA6A6; color:#4A4A4A; border:1px solid rgba(42, 93, 143, 0.2); border-radius:6px; padding:10px 14px; font-size:14px; font-weight:700; cursor:pointer;">
            Load
        </button>
    </div>

    @if (Model.Details != null)
    {
        <div style="margin:0 0 12px; color:#4A4A4A; border:1px solid #C7CED6; border-radius:8px; padding:12px; background:#FFFFFF;">
            <p style="margin:0 0 8px; font-weight:700;">Main_System delete flow</p>
            <ul style="margin:0; padding-left:20px;">
                <li>Initial secondary authentication + deletion reason</li>
                <li>Username + IRD validation for the selected account</li>
                <li>Final deletion confirmation + final secondary authentication</li>
                <li>Deletes account record, IRD record, and related username/password index entries</li>
            </ul>
        </div>

        <dl style="margin:0; color:#4A4A4A; display:grid; grid-template-columns:220px 1fr; row-gap:8px;">
            <dt style="font-weight:700;">Account Type</dt>
            <dd style="margin:0;">@Model.Details.AccountType</dd>
            <dt style="font-weight:700;">Business Role</dt>
            <dd style="margin:0;">@Model.Details.BusinessRole</dd>
            <dt style="font-weight:700;">Job Role</dt>
            <dd style="margin:0;">@Model.Details.JobRole</dd>
            <dt style="font-weight:700;">First Name</dt>
            <dd style="margin:0;">@Model.Details.FirstName</dd>
            <dt style="font-weight:700;">Last Name</dt>
            <dd style="margin:0;">@Model.Details.LastName</dd>
            <dt style="font-weight:700;">Username</dt>
            <dd style="margin:0;">@Model.Details.Username</dd>
            <dt style="font-weight:700;">Account Status</dt>
            <dd style="margin:0;">@Model.Details.AccountStatus</dd>
        </dl>

        <div style="display:flex; flex-direction:column; gap:10px; margin-top:12px; max-width:460px;">
            <label style="font-weight:700; color:#4A4A4A;">
                Reason for Deletion
                <input type="text" placeholder="Provide deletion reason" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                IRD Number (for selected account verification)
                <input type="text" placeholder="Enter IRD number" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
        </div>

        @await Html.PartialAsync(
            "~/Views/Shared/Secondary_Authentication.cshtml",
            model: null,
            viewData: new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
            {
                ["SecondaryAuthPurpose"] = "starting account deletion"
            })
        @await Html.PartialAsync(
            "~/Views/Shared/Secondary_Authentication.cshtml",
            model: null,
            viewData: new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
            {
                ["SecondaryAuthPurpose"] = "final account deletion confirmation"
            })

        <button type="button" disabled style="margin-top:12px; background:#B33A3A; color:#F5F7FA; border:none; border-radius:4px; padding:10px 14px; font-weight:700;">
            Delete Account (Next Integration)
        </button>
    }
    else
    {
        <p style="margin:0; color:#4A4A4A;">Select a group and employee, then click Load.</p>
    }
</div>

<script>
    (function () {
        const root = document.querySelector("[data-selected-account-root]");
        if (!root || root.dataset.bound === "true") {
            return;
        }

        root.dataset.bound = "true";
        const endpoint = root.dataset.endpoint || "";
        const actionKey = root.dataset.actionKey || "delete-employee-account";
        const groupSelect = root.querySelector("[data-selected-group]");
        const usernameSelect = root.querySelector("[data-selected-username]");
        const loadButton = root.querySelector("[data-load-selected-account]");
        const host = root.closest("[data-account-content-host]");

        if (!endpoint || !groupSelect || !usernameSelect || !loadButton || !host) {
            return;
        }

        async function refreshForGroup(group) {
            loadButton.disabled = true;
            try {
                const response = await fetch(`${endpoint}?actionKey=${encodeURIComponent(actionKey)}&group=${encodeURIComponent(group)}&username=`, { credentials: "same-origin" });
                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                if (typeof window.nzftcSetAccountContentHostHtml === "function") {
                    window.nzftcSetAccountContentHostHtml(host, html);
                } else {
                    host.innerHTML = html;
                }
            } catch (error) {
                console.error(error);
            } finally {
                loadButton.disabled = false;
            }
        }

        async function loadSelected(group, username) {
            if (!username) {
                host.querySelector("p")?.remove();
                const message = document.createElement("p");
                message.style.margin = "0";
                message.style.color = "#4A4A4A";
                message.textContent = "Please select an employee first.";
                host.appendChild(message);
                return;
            }

            loadButton.disabled = true;
            try {
                const response = await fetch(`${endpoint}?actionKey=${encodeURIComponent(actionKey)}&group=${encodeURIComponent(group)}&username=${encodeURIComponent(username)}`, { credentials: "same-origin" });
                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                if (typeof window.nzftcSetAccountContentHostHtml === "function") {
                    window.nzftcSetAccountContentHostHtml(host, html);
                } else {
                    host.innerHTML = html;
                }
            } catch (error) {
                console.error(error);
            } finally {
                loadButton.disabled = false;
            }
        }

        groupSelect.addEventListener("change", () => {
            refreshForGroup(groupSelect.value);
        });

        loadButton.addEventListener("click", () => {
            loadSelected(groupSelect.value, usernameSelect.value);
        });
    })();
</script>
@{
    Layout = null;
}

<div>
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">Create New Account</h2>
    <p style="margin:0 0 12px; color:#4A4A4A;">
        New account creation is still completed through the Main_System desktop administration flow.
    </p>
    <div style="display:flex; flex-direction:column; gap:12px; max-width:640px; color:#4A4A4A;">
        <div style="border:1px solid #C7CED6; border-radius:8px; background:#FFFFFF; padding:14px;">
            <p style="margin:0 0 8px; font-weight:700; color:#2A5D8F;">Desktop workflow checklist</p>
            <ul style="margin:0; padding-left:20px;">
                <li>Choose account type and business role.</li>
                <li>Record the full personal and contact details.</li>
                <li>Validate the employee IRD number before account creation.</li>
                <li>Assign any manager, mentor, or delegated relationship required by the role.</li>
                <li>Create the username and password using the Main_System administration flow.</li>
            </ul>
        </div>
        <p style="margin:0;">
            This web screen is now a guidance panel only, so it does not present an inactive submit form.
        </p>
    </div>
</div>
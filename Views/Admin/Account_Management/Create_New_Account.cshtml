@{
    Layout = null;
}

<div>
    <h2 style="color:#2A5D8F; font-size:22px; margin:0 0 12px;">Create New Account</h2>
    <p style="margin:0 0 12px; color:#4A4A4A;">
        This draft follows Main_System create-account context: account type, role mapping, full personal/contact details, IRD validation, generated username context, and role assignment where required.
    </p>

    <form>
        <div style="display:flex; flex-direction:column; gap:10px; max-width:520px;">
            <label style="font-weight:700; color:#4A4A4A;">
                Account Type
                <select style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;">
                    <option value="">Select account type...</option>
                    <option>Admin</option>
                    <option>Employee</option>
                </select>
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                First Name
                <input type="text" placeholder="Enter first name" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Middle Name (or N/A)
                <input type="text" placeholder="Enter middle name or N/A" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Last Name
                <input type="text" placeholder="Enter last name" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Date of Birth (DD-MM-YYYY)
                <input type="text" placeholder="DD-MM-YYYY" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                House Number
                <input type="text" placeholder="Enter house number" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Street Name
                <input type="text" placeholder="Enter street name" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Suburb
                <input type="text" placeholder="Enter suburb" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                City
                <input type="text" placeholder="Enter city" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Postcode
                <input type="text" placeholder="Enter postcode" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                PO Box (or None)
                <input type="text" placeholder="Enter PO Box or None" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                Email Address
                <input type="email" placeholder="Enter email address" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Phone Number
                <input type="text" placeholder="Enter phone number" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                IRD Number (must be confirmed)
                <input type="text" placeholder="Enter IRD number" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                Business Department
                <select style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;">
                    <option value="">Select a department...</option>
                    <option>Admin</option>
                    <option>Finance</option>
                    <option>Trade</option>
                </select>
            </label>
            <label style="font-weight:700; color:#4A4A4A;">
                Job Role
                <select style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;">
                    <option value="">Select a job role...</option>
                </select>
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                Role Assignment (if required: Main Manager / Assigned Manager / Assigned Mentor)
                <select style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;">
                    <option value="">Select assignment target...</option>
                </select>
            </label>

            <label style="font-weight:700; color:#4A4A4A;">
                Password
                <input type="password" autocomplete="new-password" placeholder="Enter password" style="width:100%; padding:8px; border:1px solid #C7CED6; border-radius:4px; background:#fff;" />
            </label>

            <button type="button" disabled style="background:#C7CED6; color:#4A4A4A; border:none; border-radius:4px; padding:10px 14px; font-weight:700; width:max-content;">
                Create Account (Next Integration)
            </button>
        </div>
    </form>
</div>
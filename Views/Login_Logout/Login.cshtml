@model LoginRequest
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="NZFTC EMS Login" />
    <title>NZFTC EMS - Login</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Lucida Sans', Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: #C7CED6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            min-height: 100vh;
        }

        /* LOGIN CARD - 820x480px */
        .login-card {
            width: 820px;
            height: 480px;
            background: transparent;
            border: 1px solid #F5F7FA;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        /* CARD HEADER - 70px */
        .card-header {
            height: 70px;
            background-color: #2A5D8F;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            font-family: 'Segoe UI', 'Lucida Sans', Arial, sans-serif;
        }

        /* CARD BODY - Teal background */
        .card-body {
            flex: 1;
            background-color: #5BA6A6;
            padding: 40px 120px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .form-section {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .form-spacing-top {
            height: 12px;
        }

        .field-group {
            width: 100%;
            max-width: 340px;
            margin: 0 auto;
        }

        /* INPUT FIELDS - 36px height */
        .form-field {
            display: block;
            width: 100%;
            height: 36px;
            background-color: white;
            border: none;
            padding: 6px;
            font-size: 14px;
            font-family: 'Roboto', Arial, sans-serif;
            color: #4A4A4A;
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }

        .form-field:focus {
            outline: 2px solid #1A73E8;
            outline-offset: 1px;
        }

        .form-field::placeholder {
            color: #999999;
            opacity: 1;
        }

        .form-field::-webkit-autofill {
            -webkit-box-shadow: 0 0 0 30px white inset;
            -webkit-text-fill-color: #4A4A4A;
        }

        .bottom-section {
            display: flex;
            flex-direction: column;
            gap: 18px;
            align-items: center;
        }

        /* FORGOT PASSWORD LABEL */
        .forgot-password {
            background-color: #e9e9e9;
            padding: 4px;
            color: #222;
            font-size: 14px;
            cursor: pointer;
            user-select: none;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            transition: all 0.2s ease;
            border-radius: 2px;
        }

        .forgot-password:hover {
            background-color: #e9e9e9;
            padding: 6px 10px;
            border: 2px inset #4A4A4A;
            border-radius: 2px;
        }

        .spacer {
            flex: 1;
        }

        /* LOGIN BUTTON - 220x44px */
        .login-btn {
            width: 220px;
            height: 44px;
            background-color: #1A73E8;
            color: white;
            border: 2px solid #F5F7FA;
            border-radius: 2px;
            font-size: 20px;
            font-weight: 700;
            font-family: 'Roboto', Arial, sans-serif;
            cursor: pointer;
            transition: background-color 0.2s ease;
            -webkit-appearance: none;
            appearance: none;
        }

        .login-btn:hover:not(:disabled) {
            background-color: #2E7D6F;
        }

        .login-btn:active:not(:disabled) {
            transform: scale(0.98);
        }

        .login-btn:disabled {
            opacity: 0.8;
            cursor: not-allowed;
        }

        .login-btn:focus {
            outline: 2px solid #1A73E8;
            outline-offset: 2px;
        }

        .auth-message {
            background-color: #f8d7da;
            color: #721c24;
            padding: 12px;
            border-radius: 4px;
            margin-bottom: 12px;
            font-size: 14px;
            text-align: center;
            border: 1px solid #f5c6cb;
        }

        .auth-message.info {
            background-color: #d1ecf1;
            color: #0c5460;
            border-color: #bee5eb;
        }

        .error-list {
            list-style: none;
            margin-top: 8px;
        }

        .error-list li {
            margin: 4px 0;
        }

        /* FIELD ERRORS */
        .field-error {
            color: #721c24;
            font-size: 12px;
            margin-top: 2px;
        }

        /* FOOTER */
        .login-footer {
            margin-top: 30px;
            text-align: center;
            color: #4A4A4A;
            font-size: 12px;
            font-family: 'Roboto', Arial, sans-serif;
            line-height: 1.6;
        }

        .login-footer p {
            margin: 4px 0;
        }

        .login-footer a {
            color: inherit;
            text-decoration: underline;
        }

        .login-footer a:hover,
        .login-footer a:focus {
            text-decoration: none;
        }

        /* Responsive design */
        @@media (max-width: 900px) {
            .login-card {
                width: 90vw;
                max-width: 820px;
            }
            
            .card-body {
                padding: 30px 60px;
            }
        }

        @@media (max-width: 600px) {
            .login-card {
                height: auto;
                width: 95vw;
            }
            
            .card-body {
                padding: 20px 30px;
            }
            
            .card-header {
                font-size: 24px;
                height: 60px;
            }
            
            body {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- LOGIN CARD -->
    <div class="login-card">
        <!-- HEADER -->
        <div class="card-header">NZFTC</div>

        <!-- BODY -->
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(ViewBag.AuthMessage as string))
            {
                <div class="auth-message @(ViewBag.AuthMessageType ?? "error")">
                    @ViewBag.AuthMessage
                </div>
            }

            <form method="post" action="@Url.Action("Login", "Login")" novalidate style="display: flex; flex-direction: column; gap: 18px; flex: 1;">
                @Html.AntiForgeryToken()

                <div class="form-spacing-top"></div>

                <div class="field-group">
                    <input type="text"
                           class="form-field"
                           id="username"
                           name="username"
                           placeholder="Username"
                           value="@Model?.Username"
                           required
                           autocomplete="username">
                    @if (ViewData.ModelState["Username"]?.Errors.Count > 0)
                    {
                        <div class="field-error">
                            @foreach (var error in ViewData.ModelState["Username"]!.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>

                <div class="field-group">
                    <input type="password"
                           class="form-field"
                           id="password"
                           name="password"
                           placeholder="Password"
                           required
                           autocomplete="current-password">
                    @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                    {
                        <div class="field-error">
                            @foreach (var error in ViewData.ModelState["Password"]!.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }
                </div>

                <div class="spacer"></div>

                <div style="display: flex; flex-direction: column; align-items: center; gap: 50px;">
                    <div class="forgot-password">forgot password</div>
                    <button type="submit" class="login-btn">Login</button>
                </div>
            </form>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="login-footer">
        <p>NZFTC EMS - @DateTime.Now.Year</p>
        <p>&copy; Georgia K OSullivan. All rights reserved. <a asp-controller="Privacy" asp-action="Privacy_Policy">Privacy Policy</a></p>
    </div>

    <script>
        // Add hover interactions for forgot password
        const forgotBtn = document.querySelector('.forgot-password');
        if (forgotBtn) {
            forgotBtn.addEventListener('mouseenter', function() {
                this.style.padding = '6px 10px';
                this.style.border = '2px inset #4A4A4A';
                this.style.borderRadius = '2px';
            });
            forgotBtn.addEventListener('mouseleave', function() {
                this.style.padding = '4px';
                this.style.border = 'none';
                this.style.borderRadius = '0';
            });
        }

        // Prevent double submit
        document.querySelector('form').addEventListener('submit', function() {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Logging in...';
        });
    </script>
</body>
</html>

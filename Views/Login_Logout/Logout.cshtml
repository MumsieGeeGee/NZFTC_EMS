@{
    ViewData["Title"] = "Logout";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="description" content="NZFTC EMS Logout" />
    <title>NZFTC EMS - Logout</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Lucida Sans', Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-color: #C7CED6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px;
            min-height: 100vh;
        }

        .logout-card {
            width: 820px;
            min-height: 360px;
            background: transparent;
            border: 1px solid #F5F7FA;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            height: 70px;
            background-color: #2A5D8F;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            font-family: 'Segoe UI', 'Lucida Sans', Arial, sans-serif;
        }

        .card-body {
            flex: 1;
            background-color: #5BA6A6;
            padding: 40px 120px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 28px;
            text-align: center;
        }

        .auth-message {
            background-color: #f8d7da;
            color: #721c24;
            padding: 12px;
            border-radius: 4px;
            font-size: 14px;
            text-align: center;
            border: 1px solid #f5c6cb;
        }

        .auth-message.info {
            background-color: #d1ecf1;
            color: #0c5460;
            border-color: #bee5eb;
        }

        .logout-text {
            color: #1f2b38;
            font-size: 18px;
            line-height: 1.6;
        }

        .logout-actions {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .logout-btn,
        .cancel-link {
            min-width: 220px;
            height: 44px;
            border-radius: 2px;
            font-size: 18px;
            font-weight: 700;
            font-family: 'Roboto', Arial, sans-serif;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .logout-btn {
            background-color: #1A73E8;
            color: white;
            border: 2px solid #F5F7FA;
            cursor: pointer;
        }

        .cancel-link {
            background-color: #F5F7FA;
            color: #1f2b38;
            border: 2px solid #2A5D8F;
        }

        .login-footer {
            margin-top: 30px;
            text-align: center;
            color: #4A4A4A;
            font-size: 12px;
            font-family: 'Roboto', Arial, sans-serif;
            line-height: 1.6;
        }

        .login-footer p {
            margin: 4px 0;
        }

        .login-footer a {
            color: inherit;
            text-decoration: underline;
        }

        .login-footer a:hover,
        .login-footer a:focus {
            text-decoration: none;
        }

        @@media (max-width: 900px) {
            .logout-card {
                width: 90vw;
                max-width: 820px;
            }

            .card-body {
                padding: 30px 60px;
            }
        }

        @@media (max-width: 600px) {
            .logout-card {
                width: 95vw;
            }

            .card-body {
                padding: 20px 30px;
            }

            .card-header {
                font-size: 24px;
                height: 60px;
            }

            body {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="logout-card">
        <div class="card-header">NZFTC</div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(ViewBag.AuthMessage as string))
            {
                <div class="auth-message @(ViewBag.AuthMessageType ?? "error")">
                    @ViewBag.AuthMessage
                </div>
            }

            <p class="logout-text">Are you sure you want to log out of NZFTC EMS?</p>

            <div class="logout-actions">
                <form method="post" action="@Url.Action("Logout", "Login")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
                <a class="cancel-link" href="@Url.Action("Login", "Login")">Return to Login</a>
            </div>
        </div>
    </div>

    <div class="login-footer">
        <p>NZFTC EMS - @DateTime.Now.Year</p>
        <p>&copy; Georgia K OSullivan. All rights reserved. <a asp-controller="Privacy" asp-action="Privacy_Policy">Privacy Policy</a></p>
    </div>
</body>
</html>
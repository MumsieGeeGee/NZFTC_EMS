@{
    Layout = null;
    var purpose = (string?)ViewData["SecondaryAuthPurpose"] ?? "sensitive changes";
}

<div style="margin-top:12px; border:1px solid #C7CED6; border-radius:8px; padding:12px; background:#FFFFFF;">
    <h3 style="margin:0 0 10px; color:#2A5D8F; font-size:18px;">Secondary Authentication</h3>
    <p style="margin:0 0 10px; color:#4A4A4A;">
        Secondary authentication is required before @purpose.
    </p>
    <ul style="margin:0; padding-left:20px; color:#4A4A4A;">
        <li>Follow the organisation's approved second-factor verification process.</li>
        <li>Record the verification outcome in the staff member's audit trail when the action is completed.</li>
        <li>Only continue once the required approver or administrator has confirmed the verification step.</li>
    </ul>
</div>